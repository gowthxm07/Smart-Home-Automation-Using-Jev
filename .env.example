# ==============================================================================
# HomeMind Environment Configuration
# ==============================================================================
# IMPORTANT:
# - This file is a template for required environment variables.
# - DO NOT commit real API keys or secrets to version control.
# - Copy this file to '.env.local' for local development:
#     cp .env.example .env.local
# - Secrets must remain strictly SERVER-SIDE. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# TypeSafe Jev API Key (Required for Phase 2 Jev Decision Engine)
# Obtain your API key from TypeSafe: https://api.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Custom TypeSafe Base URL (defaults to https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# ==============================================================================
# Ollama Local Runtime Configuration (Phase 3 Milestone 3.6 LLM Decision Engine)
# ==============================================================================
# Ollama runs purely locally without requiring an API key or cloud credentials.
# Default base URL is http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configurable Ollama model identifier (e.g. llama3.2:3b, llama3, mistral, etc.)
OLLAMA_MODEL=llama3.2:3b
