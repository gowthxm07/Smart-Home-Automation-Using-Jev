# ==============================================================================
# HomeMind Environment Configuration
# ==============================================================================
# IMPORTANT:
# - This file is a template for required environment variables.
# - DO NOT commit real API keys or secrets to version control.
# - Copy this file to '.env.local' for local development:
#     cp .env.example .env.local
# - Secrets must remain strictly SERVER-SIDE. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# TypeSafe Jev API Key (Required for Phase 2 Jev Decision Engine)
# Obtain your API key from TypeSafe: https://api.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Custom TypeSafe Base URL (defaults to https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
