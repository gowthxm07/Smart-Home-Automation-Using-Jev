{
  "name": "homemind-smart-home-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "HomeMind — Context-Aware Multi-Device Smart Home Automation",
  "repository": {
    "type": "git",
    "url": "https://github.com/gowthxm07/Smart-Home-Automation-Using-Laya.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark:jev": "npx tsx scripts/runJevBenchmark.ts",
    "experiment:comparison": "npx tsx scripts/runControlledExperiment.ts",
    "experiment:llm-readiness": "npx tsx scripts/runControlledExperiment.ts --llm-readiness",
    "experiment:laya-readiness": "npx tsx scripts/runControlledExperiment.ts --laya-readiness",
    "experiment:preflight": "npx tsx scripts/runControlledExperiment.ts --preflight",
    "experiment:dry-run": "npx tsx scripts/runControlledExperiment.ts --dry-run",
    "analysis:baseline": "npx tsx scripts/generateBaselineAnalysis.ts"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
